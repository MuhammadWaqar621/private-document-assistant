# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/querynest

# Qdrant
QDRANT_URL=http://qdrant:6333
# Only needed for Qdrant Cloud - leave blank for the local docker-compose Qdrant
QDRANT_API_KEY=
QDRANT_COLLECTION=querynest_documents
# Minimum cosine similarity for a retrieved chunk to be treated as
# relevant (see app/engine/rag.py). Below this, retrieval is treated as
# "nothing relevant found" even though a document exists.
RAG_MIN_RELEVANCE_SCORE=0.75

# Frontend (used to build links in password-reset emails). 5173 = vite dev
# server, 4173 = the docker-compose "frontend" service.
FRONTEND_URL=http://localhost:5173

# Read by docker-compose (not the backend) as a build ARG for the frontend
# image - Vite inlines VITE_* vars at build time. Since the browser talks
# to the backend directly (not through the frontend container), this
# should be a URL the browser itself can reach - localhost:8000 works for
# the default docker-compose setup.
VITE_API_BASE_URL=http://localhost:8000

# Azure OpenAI - Embeddings
AZURE_EM_ENDPOINT=
AZURE_EM_API_KEY=
AZURE_EM_API_VERSION=
AZURE_EM_MODEL=
# Vector size the embedding deployment above returns - used to size the
# Qdrant collection. Azure text-embedding models are typically 1536
# (text-embedding-ada-002 / text-embedding-3-small) or 3072
# (text-embedding-3-large). Optional: defaults to 1536 in code
# (app/engine/azure_client.py) if left blank.
AZURE_EM_DIMENSIONS=1536

# Azure OpenAI - Chat (any Azure OpenAI chat deployment)
LLM_ENDPOINT=
LLM_ENDPOINT_APIKEY=
LLM_MODEL_NAME=

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP (forgot-password emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
